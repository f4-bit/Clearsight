// Clearsight clinical database (PostgreSQL).
//
// Baseline: docker/init.sql (migration `0_init`, applied verbatim).
// Deltas on top of it live in `20261027000000_prisma_alignment`.
// Table/column names stay snake_case in the DB (@@map / @map) so the Python
// ETL (scripts/retrain_cycle.py) and any raw SQL keep working unchanged.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // Keeps the generated imports valid after `tsc` (it does not rewrite ".ts").
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OFTALMOLOGO
  INVESTIGADOR
  ADMIN

  @@map("user_role")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name") @db.VarChar(255)
  role         UserRole @default(OFTALMOLOGO)
  isActive     Boolean  @default(true) @map("is_active")
  // Future auth metadata; existing rows default to enabled/zero counters.
  tokenVersion     Int       @default(0) @map("token_version")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  consultations       Consultation[]
  feedback            ClinicalFeedback[]
  sessions            UserSession[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  idempotencyRecords  IdempotencyRecord[]
  auditEventsAsActor  AuditEvent[]          @relation("AuditActor")
  auditEventsAsTarget AuditEvent[]          @relation("AuditTarget")
  ownedPatients       Patient[]             @relation("PatientOwner")
  grantsReceived      InferenceAccessGrant[] @relation("GrantRecipient")
  grantsApproved      InferenceAccessGrant[] @relation("GrantApprover")

  @@map("users")
}

model Patient {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalCode         String?  @map("external_code") @db.VarChar(64)
  age                  Int?
  gender               String?  @db.VarChar(16)
  clinicalHistoryFlags Json     @default("{}") @map("clinical_history_flags") @db.JsonB
  clinicalData         Json     @default("{}") @map("clinical_data") @db.JsonB
  // Access owner. NULL = legacy/orphan profile, only assignable once and never
  // reassignable; the SQL migration enforces the immutable-once-set rule.
  ownerDoctorId        String?  @map("owner_doctor_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ownerDoctor   User?          @relation("PatientOwner", fields: [ownerDoctorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  consultations Consultation[]

  @@index([externalCode], map: "idx_patients_external_code")
  @@index([ownerDoctorId], map: "idx_patients_owner_doctor_id")
  @@map("patients")
}

model Consultation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  doctorId     String   @map("doctor_id") @db.Uuid
  // Same vocabulary as ml/service/schemas.py JobStatus (enforced by a CHECK).
  status       String   @default("QUEUED") @db.VarChar(32)
  clinicalData Json     @default("{}") @map("clinical_data") @db.JsonB
  // Explicit required-execution selection; empty + NULL version/frozenAt = open
  // legacy state (not a phantom v1). Frozen rows reject later changes in SQL.
  requiredExecutionIds String[]  @default([]) @map("required_execution_ids") @db.Uuid
  requiredSetVersion   String?   @map("required_set_version") @db.VarChar(128)
  requiredSetFrozenAt  DateTime? @map("required_set_frozen_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  patient   Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  doctor    User               @relation(fields: [doctorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  images    Image[]
  inferences Inference[]
  snapshots ClinicalSnapshot[]
  feedback  ClinicalFeedback[]
  accessGrants InferenceAccessGrant[]

  @@index([patientId], map: "idx_consultations_patient_id")
  @@index([doctorId], map: "idx_consultations_doctor_id")
  @@index([status], map: "idx_consultations_status")
  @@index([requiredExecutionIds], type: Gin, map: "idx_consultations_required_execution_ids")
  @@map("consultations")
}

/// Immutable clinical snapshot captured by an execution. The SQL migration
/// enforces jsonb objects, a non-empty schema version and rejects UPDATE/DELETE;
/// those triggers are intentionally not representable in the Prisma schema.
model ClinicalSnapshot {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consultationId    String   @map("consultation_id") @db.Uuid
  rawPayload        Json     @map("raw_payload") @db.JsonB
  normalizedPayload Json     @map("normalized_payload") @db.JsonB
  schemaVersion     String   @map("schema_version") @db.VarChar(128)
  // Exact resolved versions when known; `{}` means "not resolved", never a fake registry.
  modelVersions     Json     @default("{}") @map("model_versions") @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  inferences   Inference[]
  pdfReports   PdfReport[]

  @@index([consultationId], map: "idx_clinical_snapshots_consultation_id")
  @@map("clinical_snapshots")
}

model Image {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consultationId String   @map("consultation_id") @db.Uuid
  // 'OD' | 'OS' (CHECK constraint in the DB, Zod enum in the API).
  eyeSide        String   @map("eye_side") @db.VarChar(2)
  storagePath    String   @map("storage_path")
  hashMd5        String?  @map("hash_md5") @db.VarChar(32)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inferences   Inference[]

  @@index([consultationId], map: "idx_images_consultation_id")
  @@index([hashMd5], map: "idx_images_hash_md5")
  @@map("images")
}

model Inference {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imageId        String   @map("image_id") @db.Uuid
  jobId          String?  @unique @map("job_id") @db.Uuid
  // ML class index: 0 = Glaucoma, 1 = Non_Glaucoma, 2 = Suspicious_Glaucoma
  // (order of ml/models/manifest.json -> class_names).
  predictedClass Int?     @map("predicted_class")
  confidence     Float?
  probabilities  Json     @default("{}") @db.JsonB
  // Actual result returned by the ML wire; separate from snapshot.modelVersions.
  modelVersions    Json @default("{}") @map("model_versions") @db.JsonB
  modelPredictions Json @default("{}") @map("model_predictions") @db.JsonB
  // Area-based CDR (model input) vs vertical CDR (clinical report): never interchangeable.
  cdr            Float?
  cdrVertical    Float?   @map("cdr_vertical")
  quality        Json     @default("{}") @db.JsonB
  artifacts      Json     @default("{}") @db.JsonB
  elapsedSeconds Float?   @map("elapsed_seconds")
  gradcamPath    String?  @map("gradcam_path")
  modelVersion   String?  @map("model_version") @db.VarChar(128)
  // Execution metadata added by migration A. Legacy rows stay NULL; the SQL
  // trigger validates any non-NULL copy against the authoritative Image.
  consultationId    String?  @map("consultation_id") @db.Uuid
  eyeSide           String?  @map("eye_side") @db.VarChar(2)
  // Canonical column is clinical_snapshot_id; the client property is snapshotId.
  snapshotId        String?  @map("clinical_snapshot_id") @db.Uuid
  // Exact JobStatus vocabulary, enforced by a SQL CHECK (no PROCESSING).
  status            String?  @db.VarChar(32)
  reanalysisOfId    String?  @map("reanalysis_of_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  image        Image              @relation(fields: [imageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  consultation Consultation?      @relation(fields: [consultationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  snapshot     ClinicalSnapshot?  @relation(fields: [snapshotId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reanalysisOf Inference?         @relation("InferenceReanalysis", fields: [reanalysisOfId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reanalyses   Inference[]        @relation("InferenceReanalysis")
  feedback     ClinicalFeedback[]
  artifactRecords     ArtifactRecord[]
  pdfReports          PdfReport[]
  idempotencyRecords  IdempotencyRecord[]
  accessGrants        InferenceAccessGrant[]

  @@index([imageId], map: "idx_inferences_image_id")
  @@index([predictedClass], map: "idx_inferences_predicted_class")
  @@index([consultationId], map: "idx_inferences_consultation_id")
  @@index([snapshotId], map: "idx_inferences_clinical_snapshot_id")
  @@index([reanalysisOfId], map: "idx_inferences_reanalysis_of_id")
  @@map("inferences")
}

/// Binary/file artifact reference. `result` is not stored here: it is the
/// existing inline Inference projection. Published (AVAILABLE) rows are
/// completely immutable; a later failure is a new explicit version/attempt.
/// URI/signature rejection, state completeness and immutability are enforced
/// by SQL constraints/triggers not representable in Prisma.
model ArtifactRecord {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inferenceId       String    @map("inference_id") @db.Uuid
  artifactType      String    @map("artifact_type") @db.VarChar(32)
  version           Int       @default(1)
  status            String    @default("PENDING") @db.VarChar(16)
  storageId         String?   @map("storage_id") @db.VarChar(128)
  bucketOrContainer String?   @map("bucket_or_container") @db.VarChar(255)
  key               String?
  contentType       String?   @map("content_type") @db.VarChar(255)
  sizeBytes         BigInt?   @map("size_bytes") @db.BigInt
  // Fixed lowercase SHA-256 hex; the SQL CHECK rejects other cases/lengths.
  checksumSha256    String?   @map("checksum_sha256") @db.VarChar(64)
  failureCode       String?   @map("failure_code") @db.VarChar(64)
  retryable         Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  availableAt       DateTime? @map("available_at") @db.Timestamptz(6)

  inference  Inference   @relation(fields: [inferenceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  pdfReports PdfReport[]

  @@unique([inferenceId, artifactType, version], map: "artifact_records_inference_id_artifact_type_version_key")
  @@index([inferenceId], map: "idx_artifact_records_inference_id")
  @@index([status], map: "idx_artifact_records_status")
  @@map("artifact_records")
}

/// Immutable, versioned PDF/report row. Rendering inputs are fixed from
/// creation; PENDING may transition to AVAILABLE/FAILED, FAILED may return to
/// PENDING, and AVAILABLE is completely immutable. The linked artifact must be
/// a pdf artifact of the same inference/version (SQL trigger).
model PdfReport {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inferenceId      String    @map("inference_id") @db.Uuid
  version          Int
  artifactId       String?   @map("artifact_id") @db.Uuid
  sourceSnapshotId String?   @map("source_snapshot_id") @db.Uuid
  status           String    @default("PENDING") @db.VarChar(16)
  documentKind     String    @default("basic") @map("document_kind") @db.VarChar(32)
  dataVersion      String    @map("data_version") @db.VarChar(128)
  modelVersions    Json      @default("{}") @map("model_versions") @db.JsonB
  renderingInputs  Json      @default("{}") @map("rendering_inputs") @db.JsonB
  availableAt      DateTime? @map("available_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  inference      Inference         @relation(fields: [inferenceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  artifact       ArtifactRecord?   @relation(fields: [artifactId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sourceSnapshot ClinicalSnapshot? @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([inferenceId, version], map: "pdf_reports_inference_id_version_key")
  @@index([inferenceId], map: "idx_pdf_reports_inference_id")
  @@index([artifactId], map: "idx_pdf_reports_artifact_id")
  @@index([sourceSnapshotId], map: "idx_pdf_reports_source_snapshot_id")
  @@index([status], map: "idx_pdf_reports_status")
  @@map("pdf_reports")
}

/// Explicit, time-bounded dataset grant that lets a non-doctor (ADMIN or
/// INVESTIGADOR) read one specific inference. It never grants clinical write,
/// patient/consultation access, and it never extends to a reanalysis child.
/// The SQL migration enforces the captured-consultation match, immutability of
/// every term, append-only revocation, expiry and the at-least-one-capability
/// rule. There is deliberately no `@updatedAt` column, so the app role can only
/// perform the monotonic `revoked_at` column update.
model InferenceAccessGrant {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inferenceId           String    @map("inference_id") @db.Uuid
  // Captured from the authoritative image at approval time; never client input.
  consultationId        String    @map("consultation_id") @db.Uuid
  recipientUserId       String    @map("recipient_user_id") @db.Uuid
  // Bounded logical approval code (never a URL). Immutable.
  approvalReference     String    @map("approval_reference") @db.VarChar(128)
  // Trusted offline operator metadata; NULL is the explicit SYSTEM approval.
  approvedByUserId      String?   @map("approved_by_user_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(6)
  readResult            Boolean   @default(false) @map("read_result")
  readArtifacts         Boolean   @default(false) @map("read_artifacts")
  readPdf               Boolean   @default(false) @map("read_pdf")
  canExportGoldStandard Boolean   @default(false) @map("can_export_gold_standard")

  inference     Inference    @relation(fields: [inferenceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  consultation  Consultation @relation(fields: [consultationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  recipientUser User         @relation("GrantRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  approvedByUser User?       @relation("GrantApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([recipientUserId, inferenceId, approvalReference], map: "inference_access_grants_recipient_inference_approval_key")
  @@index([inferenceId], map: "idx_inference_access_grants_inference_id")
  @@index([consultationId], map: "idx_inference_access_grants_consultation_id")
  @@index([recipientUserId], map: "idx_inference_access_grants_recipient_user_id")
  @@index([expiresAt], map: "idx_inference_access_grants_expires_at")
  @@map("inference_access_grants")
}

/// Durable session metadata. The session identity/expiry are immutable from
/// creation; revocation is append-only and lastUsedAt is monotonic. The SQL
/// trigger also requires an active user and a matching issued tokenVersion.
model UserSession {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  issuedTokenVersion Int       @map("issued_token_version")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  reasonCode         String?   @map("reason_code") @db.VarChar(64)
  lastUsedAt         DateTime? @map("last_used_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  refreshTokens RefreshToken[]

  @@index([userId], map: "idx_user_sessions_user_id")
  @@index([expiresAt], map: "idx_user_sessions_expires_at")
  @@map("user_sessions")
}

/// Durable login-protection counters (HU01 + complementary per-IP quota).
/// Only purpose-scoped HMAC pseudonymous hashes are stored; no raw email, IP,
/// secret or password column exists. There is intentionally no FK to users:
/// unknown identifiers are counted and account deletion must not evict state.
model AuthLoginBucket {
  kind            String    @db.VarChar(16)
  keyHash         String    @map("key_hash") @db.VarChar(64)
  failureCount    Int       @default(0) @map("failure_count")
  windowStartedAt DateTime? @map("window_started_at") @db.Timestamptz(6)
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([kind, keyHash])
  @@index([lockedUntil], map: "idx_auth_login_buckets_locked_until")
  @@index([updatedAt], map: "idx_auth_login_buckets_updated_at")
  @@map("auth_login_buckets")
}

/// Fixed-window password-recovery quota bucket. Only purpose-scoped
/// HMAC-SHA256 pseudonymous key hashes are stored; there is no raw email/IP/
/// secret/token column and no FK to users (unknown/inactive identifiers share
/// the same guard path). `kind` is one of FORGOT_EMAIL, FORGOT_IP or RESET_IP.
model AuthRecoveryBucket {
  kind            String   @db.VarChar(16)
  keyHash         String   @map("key_hash") @db.VarChar(64)
  attemptCount    Int      @default(0) @map("attempt_count")
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([kind, keyHash])
  @@index([windowStartedAt], map: "idx_auth_recovery_buckets_window_started_at")
  @@index([updatedAt], map: "idx_auth_recovery_buckets_updated_at")
  @@map("auth_recovery_buckets")
}

/// Append-only audit record. Actor/target identity, action, outcome, timestamp
/// and metadata are immutable; SQL rules enforce actor/target pairing and the
/// bounded metadata defense. No tokens, SAS or URLs are expected.
model AuditEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorKind    String   @map("actor_kind") @db.VarChar(16)
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  targetType   String   @map("target_type") @db.VarChar(64)
  targetId     String?  @map("target_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  action       String   @db.VarChar(64)
  outcome      String   @db.VarChar(16)
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  requestId    String?  @map("request_id") @db.Uuid
  metadata     Json     @default("{}") @db.JsonB

  actorUser  User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  targetUser User? @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([actorUserId], map: "idx_audit_events_actor_user_id")
  @@index([targetUserId], map: "idx_audit_events_target_user_id")
  @@index([targetId], map: "idx_audit_events_target_id")
  @@index([action], map: "idx_audit_events_action")
  @@index([occurredAt], map: "idx_audit_events_occurred_at")
  @@map("audit_events")
}

/// Opaque refresh-token credential; only a lowercase SHA-256 hash is stored.
/// Parent pointers are insert-only (single successor via unique), same session
/// as the child, and consumed/revoked timestamps are append-only.
model RefreshToken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  sessionId     String    @map("session_id") @db.Uuid
  parentTokenId String?   @unique @map("parent_token_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)

  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  session    UserSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  parentToken RefreshToken? @relation("RefreshTokenParent", fields: [parentTokenId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  childTokens RefreshToken[] @relation("RefreshTokenParent")

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@index([sessionId], map: "idx_refresh_tokens_session_id")
  @@index([expiresAt], map: "idx_refresh_tokens_expires_at")
  @@map("refresh_tokens")
}

/// Single-use password reset credential; only a lowercase SHA-256 hash is
/// stored, expiry is capped at 30 minutes and consumed/revoked are append-only.
model PasswordResetToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([userId], map: "idx_password_reset_tokens_user_id")
  @@index([expiresAt], map: "idx_password_reset_tokens_expires_at")
  @@map("password_reset_tokens")
}

/// Persisted idempotency replay record. Scope/key/hash, execution and pinned
/// model versions are fixed at creation; PENDING may become ACCEPTED once and
/// accepted rows are immutable/non-deletable until retention is approved.
model IdempotencyRecord {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId           String    @map("actor_user_id") @db.Uuid
  scope                 String    @db.VarChar(128)
  key                   String    @db.VarChar(128)
  payloadHash           String    @map("payload_hash") @db.VarChar(64)
  inferenceId           String    @map("inference_id") @db.Uuid
  resolvedModelVersions Json      @map("resolved_model_versions") @db.JsonB
  state                 String    @default("PENDING") @db.VarChar(16)
  responseStatus        Int?      @map("response_status")
  responseBody          Json?     @map("response_body") @db.JsonB
  acceptedAt            DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  actorUser User      @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  inference Inference @relation(fields: [inferenceId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([actorUserId, scope, key], map: "idempotency_records_actor_user_id_scope_key_key")
  @@index([inferenceId], map: "idx_idempotency_records_inference_id")
  @@index([acceptedAt], map: "idx_idempotency_records_accepted_at")
  @@map("idempotency_records")
}

model ClinicalFeedback {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consultationId String   @map("consultation_id") @db.Uuid
  inferenceId    String   @map("inference_id") @db.Uuid
  doctorId       String   @map("doctor_id") @db.Uuid
  predictedClass Int?     @map("predicted_class")
  // NULL = "no concluyente". Such rows can never be gold standard (CHECK).
  validatedClass Int?     @map("validated_class")
  confidence     Float?
  // NULL = no comparison possible (no concluyente / model gave no class).
  agreement      Boolean?
  doctorNotes    String?  @map("doctor_notes")
  isGoldStandard Boolean  @default(false) @map("is_gold_standard")
  clinicalData   Json     @default("{}") @map("clinical_data") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inference    Inference    @relation(fields: [inferenceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  doctor       User         @relation(fields: [doctorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  // One verdict per doctor per inference -> target of the upsert.
  @@unique([inferenceId, doctorId])
  @@index([consultationId], map: "idx_clinical_feedback_consultation_id")
  @@index([inferenceId], map: "idx_clinical_feedback_inference_id")
  @@index([doctorId], map: "idx_clinical_feedback_doctor_id")
  @@index([isGoldStandard], map: "idx_clinical_feedback_gold_standard")
  @@map("clinical_feedback")
}
