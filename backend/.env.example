# Backend (Fastify + Prisma). Copy to .env for local development.
NODE_ENV=development
HOST=0.0.0.0
PORT=8000

# Either set DATABASE_URL, or the POSTGRES_* variables used by docker-compose.
DATABASE_URL=postgresql://clearsight:clearsight@localhost:5432/clearsight

JWT_SECRET=replace-me-with-at-least-32-characters-of-randomness
# Secret used to pseudonymize doctor ids in gold-standard exports (HMAC-SHA256).
EXPORT_HMAC_SECRET=replace-me-too-with-another-long-random-secret

# Seed (never runs when NODE_ENV=production)
SEED_PASSWORD=ChangeMe123!
