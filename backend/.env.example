# Backend (Fastify + Prisma). Copy to .env for local development.
NODE_ENV=development
HOST=0.0.0.0
PORT=8000

# Either set DATABASE_URL, or the POSTGRES_* variables used by docker-compose.
DATABASE_URL=postgresql://clearsight:clearsight@localhost:5432/clearsight

JWT_SECRET=replace-me-with-at-least-32-characters-of-randomness
# Access-token lifetime (single policy, at most 900s; default 15m).
JWT_EXPIRES_IN=15m
# Complementary per-IP login quota (positive integers; never 0 to disable).
IP_RATE_LIMIT=100
IP_RATE_WINDOW_SECONDS=60
# Secret used to pseudonymize doctor ids in gold-standard exports (HMAC-SHA256).
EXPORT_HMAC_SECRET=replace-me-too-with-another-long-random-secret

# Seed (never runs when NODE_ENV=production)
SEED_PASSWORD=ChangeMe123!

# Redis / BullMQ
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 (backend side; the ML service has its own ML_MINIO_* set)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Only real booleans or the exact lowercase strings "true"/"false"; other
# values (TRUE, yes, 1) fail startup instead of silently disabling TLS.
MINIO_SECURE=false
MINIO_BUCKET_RAW=raw-retinas
MINIO_BUCKET_GRADCAM=gradcam-overlays
# Artifact-content defaults for key-only legacy references (6.1/3.5). Each kind
# is optional; a missing kind bucket makes its key-only loads fail closed. An
# explicit STORAGE_ALLOWED_BUCKETS must also include the kind bucket.
# MINIO_BUCKET_MASK=retina-masks
# MINIO_BUCKET_OVERLAY=retina-overlays
# MINIO_BUCKET_PDF=clinical-reports
# Bounded read for the shared artifact-content seam (integer bytes).
ARTIFACT_CONTENT_MAX_BYTES=26214400

# Storage provider. `minio` is the backward-compatible default; `azure` is
# explicit. Unknown values fail closed. `STORAGE_ID` is logical only and
# defaults to `minio-local` or `azure-blob-default`.
STORAGE_PROVIDER=minio
# STORAGE_ID=minio-local
# Optional CSV allowlist for the active provider. Absent defaults to
# MINIO_BUCKET_RAW,MINIO_BUCKET_GRADCAM; an explicit empty value fails closed.
# STORAGE_ALLOWED_BUCKETS=raw-retinas,gradcam-overlays
# Signed URL lifetime in seconds (integer 1..3600; legacy callers use 3600).
STORAGE_DOWNLOAD_TTL_SECONDS=3600

# Azure Blob only (never commit real keys). The official SDK creates the
# SharedKeyCredential; the account URL must be HTTPS and exactly
# https://<account>.blob.core.windows.net (no path, query, userinfo or wildcard).
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_ACCOUNT_NAME=<account>
# AZURE_STORAGE_ACCOUNT_KEY=<base64-account-key>

# ML Service
ML_SERVICE_URL=http://localhost:8000
# Bearer token for the ML inference service; must match the ML service's ML_API_TOKEN.
ML_API_TOKEN=
# Host reachable FROM the ML service container (Docker network) used for presigned image URLs.
ML_PUBLIC_HOST=minio:9000

# CORS: comma-separated browser origins, or "*" to allow all (default in development;
# production denies all browsers unless this is set).
CORS_ORIGIN=*
