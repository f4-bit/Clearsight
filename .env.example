# Clearsight environment variable placeholders (copy to .env per deployment).

# PostgreSQL (docker-compose bootstrap + backend DATABASE_URL)
POSTGRES_DB=clearsight
POSTGRES_USER=clearsight
POSTGRES_PASSWORD=clearsight
POSTGRES_HOST=postgres

# Redis / MinIO / MLflow (internal Docker endpoints)
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_RAW=raw-retinas
MINIO_BUCKET_GRADCAM=gradcam-overlays
MLFLOW_TRACKING_URI=http://mlflow:5000

# Auth
JWT_SECRET=replace-me-with-at-least-32-characters
# Access-token lifetime (single policy, at most 900s; default 15m).
JWT_EXPIRES_IN=15m
# HMAC secret used to pseudonymize doctor ids in gold-standard exports.
EXPORT_HMAC_SECRET=replace-me-too-with-a-long-random-secret

# CORS: comma-separated browser origins allowed in production, "*" for dev.
# Production defaults to deny-all when unset.
# Example: CORS_ORIGIN=https://clearsight.clinic,https://www.clearsight.clinic
CORS_ORIGIN=*

# ML service (see docker-compose.yml and docker/ml-service.env.example)
ML_SERVICE_URL=http://localhost:8000
ML_API_TOKEN=replace-me
ML_PUBLIC_HOST=minio:9000

# Clinical Z-score normalization parameters (order matches manifest.clinical_features).
ML_CLINICAL_MEAN_JSON=[60.723785,0.598466,0.669565,-1.022379,91.245522,0.657289,13.395907,4.432225,520.534546,23.133957,-1.46757]
ML_CLINICAL_STD_JSON=[13.271913,0.490209,2.033101,0.81328,42.873653,0.474616,7.171593,7.700588,104.636459,3.359584,4.268064]
